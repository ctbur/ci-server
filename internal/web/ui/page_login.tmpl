{{ define "page_login" }}
<!doctype html>
<html lang="en">
    <head>
        {{ template "comp_head" }}
        <title>Login - CI</title>
        <style>
            .login-container {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                height: 80vh;
            }

            .btn-github {
                display: inline-flex;
                align-items: center;
                gap: 10px;
            }
        </style>
    </head>

    <body>
        <main class="login-container">
            <p>Please log in to continue if you are authorized to access this CI server.</p>
            <a href="/auth/login" class="btn-github" hx-disable>
                <span>Log in with GitHub</span>
            </a>
        </main>
    </body>
</html>
{{ end }}
